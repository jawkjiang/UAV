# --- Figure geometry ---
figure.figsize : 3.5, 3.5
figure.dpi     : 300
savefig.dpi    : 300

# --- Typography (Serif - Times New Roman) ---
font.family       : serif
font.serif        : Times New Roman
font.sans-serif   : Arial, DejaVu Sans, Liberation Sans, Helvetica
font.monospace    : JetBrains Mono, Consolas, Courier New, DejaVu Sans Mono, Liberation Mono
axes.unicode_minus: False

# --- Title/label/ticks/legend ---
axes.titlesize    : 12
axes.labelsize    : 12
xtick.labelsize   : 10
ytick.labelsize   : 10
legend.fontsize   : 10
figure.titlesize  : 12

# Embed TrueType fonts in vector outputs
pdf.fonttype      : 42
ps.fonttype       : 42

# --- Lines/axes defaults (conservative) ---
lines.linewidth   : 1.5
lines.markersize  : 5
axes.spines.top   : False
axes.spines.right : False

# Math text
# Keep DejaVu math to avoid missing glyphs; it coexists with CJK UI fonts.
mathtext.fontset  : dejavusans
mathtext.default  : regular
